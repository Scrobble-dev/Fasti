{
  "$schema": "https://design-tokens.github.io/community-group/format/2025.10/schema.json",
  "fasti": {
    "color": {
      "surface": {
        "archive": {
          "$value": "#F2EFE6",
          "$type": "color",
          "$description": "Primary warm background ground"
        },
        "paper": {
          "$value": "#FFFDF8",
          "$type": "color",
          "$description": "Reading cards, modal sheets, timeline rows"
        },
        "night": {
          "$value": "#11110F",
          "$type": "color",
          "$description": "Dark mode ground and code blocks"
        }
      },
      "text": {
        "primary": {
          "$value": "#181716",
          "$type": "color",
          "$description": "Primary high-contrast type"
        },
        "muted": {
          "$value": "#625E56",
          "$type": "color",
          "$description": "Secondary metadata and timestamps"
        }
      },
      "brand": {
        "mark": {
          "$value": "#8B2E2A",
          "$type": "color",
          "$description": "Fasti Oxblood accent for recorded events and time spine"
        }
      },
      "action": {
        "primary": {
          "$value": "#1E4FA3",
          "$type": "color",
          "$description": "Chronicle Blue for interactive links, buttons, structured data"
        }
      },
      "state": {
        "verified": {
          "$value": "#2E6F63",
          "$type": "color",
          "$description": "Verdigris for verified synchronised state and checksums"
        },
        "attention": {
          "$value": "#8C5A12",
          "$type": "color",
          "$description": "Amber for sequence gaps and pending retries"
        }
      }
    },
    "font": {
      "display": {
        "$value": "Newsreader, Georgia, serif",
        "$type": "fontFamily",
        "$description": "Editorial heading font"
      },
      "body": {
        "$value": "\"Atkinson Hyperlegible Next\", -apple-system, BlinkMacSystemFont, sans-serif",
        "$type": "fontFamily",
        "$description": "Product interface and body text"
      },
      "mono": {
        "$value": "\"Atkinson Hyperlegible Mono\", \"IBM Plex Mono\", monospace",
        "$type": "fontFamily",
        "$description": "Event IDs, timestamps, and technical metadata"
      }
    },
    "size": {
      "target": {
        "minimum": {
          "$value": "44px",
          "$type": "dimension",
          "$description": "Minimum interactive touch target size"
        }
      },
      "radius": {
        "sm": {
          "$value": "2px",
          "$type": "dimension"
        },
        "md": {
          "$value": "6px",
          "$type": "dimension"
        },
        "lg": {
          "$value": "10px",
          "$type": "dimension"
        }
      }
    },
    "space": {
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "6": { "$value": "24px", "$type": "dimension" },
      "8": { "$value": "32px", "$type": "dimension" },
      "12": { "$value": "48px", "$type": "dimension" },
      "16": { "$value": "64px", "$type": "dimension" }
    }
  }
}
