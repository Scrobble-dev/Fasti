{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fasti",
  "version": "0.1.0",
  "identifier": "dev.scrobble.fasti",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fasti",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:"
    }
  }
}
