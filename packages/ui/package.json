{
  "name": "@fasti/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fasti presentation components over generated contracts and design tokens",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsgo --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fasti/sdk": "workspace:*",
    "@fasti/tokens": "workspace:*",
    "@tabler/core": "^1.4.0",
    "@tabler/icons-svelte": "3.46.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  }
}
