cff-version: 1.2.0
message: "If you use or reference Fasti in research or software development, please cite it as below."
title: "Fasti: An Identity-First, Self-Hosted System of Record for Media Activity"
authors:
  - name: "Fasti Contributors"
    website: "https://scrobble.dev"
version: 0.1.0
date-released: "2026-08-25"
license: AGPL-3.0-or-later
repository-code: "https://github.com/Scrobble-dev/Fasti"
url: "https://scrobble.dev"
abstract: "Fasti is an open-source, identity-first local system of record for media activity. It receives scrobble observations, preserves immutable evidence, reconciles multi-provider media identity, and exposes governed history without playing media."
keywords:
  - "scrobble"
  - "scrobbling"
  - "media-tracker"
  - "self-hosted"
  - "digital-preservation"
  - "local-first"
  - "offline-first"
  - "rust"
  - "sqlite"
  - "tauri"
  - "interoperability"
