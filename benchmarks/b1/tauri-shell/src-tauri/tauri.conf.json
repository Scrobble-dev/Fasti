{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fasti B1 Empty Shell Benchmark",
  "version": "0.0.0",
  "identifier": "dev.scrobble.fasti.benchmark.empty-shell",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fasti B1 Empty Shell Benchmark",
        "width": 640,
        "height": 480,
        "visible": false,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
