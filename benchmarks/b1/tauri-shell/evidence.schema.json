{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fasti.scrobble.dev/schemas/benchmarks/b1/tauri-shell-evidence.schema.json",
  "title": "Fasti B1 benchmark-only empty Tauri shell cgroup evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "body",
    "status",
    "captured_at",
    "scope",
    "source",
    "runner",
    "environment",
    "harness",
    "artifact",
    "samples",
    "summary",
    "verdict"
  ],
  "properties": {
    "$schema": {
      "const": "https://fasti.scrobble.dev/schemas/benchmarks/b1/tauri-shell-evidence.schema.json"
    },
    "schema_version": { "const": "fasti.b1.tauri-shell-evidence.v1" },
    "body": { "const": "B1" },
    "status": { "enum": ["complete", "test_fixture"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_only",
        "product_surface",
        "window_visible",
        "served_web",
        "design_review",
        "qualifying_runner",
        "measurement_boundary",
        "fixture_policy_sha256"
      ],
      "properties": {
        "benchmark_only": { "const": true },
        "product_surface": { "const": false },
        "window_visible": { "const": false },
        "served_web": { "const": "not_applicable" },
        "design_review": {
          "const": "not_applicable_non_product_hidden_benchmark_fixture"
        },
        "qualifying_runner": {
          "const": "governed_linux_desktop_cgroup_v2"
        },
        "measurement_boundary": {
          "const": "dedicated_transient_user_scope"
        },
        "fixture_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "git_tree",
        "tree_state",
        "fixture_tree",
        "cargo_lock_sha256",
        "harness_script_sha256"
      ],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree_state": { "const": "clean" },
        "fixture_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "cargo_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "harness_script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_id",
        "os",
        "os_version",
        "kernel",
        "architecture",
        "cpu_model",
        "logical_cpu_count",
        "total_memory_bytes",
        "display_server",
        "display_evidence",
        "systemd_user_scope"
      ],
      "properties": {
        "runner_id": { "type": "string", "minLength": 1 },
        "os": { "const": "linux" },
        "os_version": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "cpu_model": { "type": "string", "minLength": 1 },
        "logical_cpu_count": { "type": "integer", "minimum": 1 },
        "total_memory_bytes": { "type": "integer", "minimum": 1 },
        "display_server": {
          "enum": ["wayland", "x11", "wayland_and_x11"]
        },
        "display_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "session_type",
            "session_class",
            "session_remote",
            "session_state",
            "seat",
            "connected_drm_connectors",
            "simulation_scan"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "session_type": { "enum": ["wayland", "x11"] },
            "session_class": { "const": "user" },
            "session_remote": { "const": false },
            "session_state": { "const": "active" },
            "seat": { "type": "string", "minLength": 1 },
            "connected_drm_connectors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "simulation_scan": { "const": "none_detected" }
          }
        },
        "systemd_user_scope": { "const": true }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_image",
        "firmware",
        "root_filesystem",
        "storage",
        "cpu_governor",
        "temperature",
        "container_runtime",
        "cgroup",
        "corpus",
        "webkit_runtime",
        "fingerprint_commands"
      ],
      "properties": {
        "os_image": {
          "$ref": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json#/$defs/osImage"
        },
        "firmware": {
          "$ref": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json#/$defs/firmware"
        },
        "root_filesystem": {
          "$ref": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json#/$defs/rootFilesystem"
        },
        "storage": {
          "$ref": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json#/$defs/storage"
        },
        "cpu_governor": {
          "$ref": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json#/$defs/cpuGovernor"
        },
        "temperature": {
          "$ref": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json#/$defs/temperature"
        },
        "container_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "not_applicable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "cgroup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "manager", "controller"],
          "properties": {
            "version": { "const": "v2" },
            "manager": { "const": "systemd_user_transient_scope" },
            "controller": { "const": "memory" }
          }
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "seed", "digest", "reason"],
          "properties": {
            "status": { "const": "not_applicable" },
            "seed": { "type": "null" },
            "digest": { "type": "null" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "webkit_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version"],
          "properties": {
            "package": { "const": "webkit2gtk-4.1" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "fingerprint_commands": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "repetitions",
        "steady_window_seconds",
        "sample_interval_ms",
        "measurement_backend",
        "network_isolation",
        "commands"
      ],
      "properties": {
        "version": { "const": "fasti-b1-tauri-shell.v1" },
        "repetitions": { "type": "integer", "minimum": 5 },
        "steady_window_seconds": { "type": "number", "minimum": 3 },
        "sample_interval_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 250
        },
        "measurement_backend": {
          "const": "linux_cgroup_v2_memory_controller"
        },
        "network_isolation": {
          "const": "route_less_user_network_namespace"
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_path", "path", "sha256", "size_bytes"],
      "properties": {
        "measurement_path": {
          "const": "benchmarks/b1/tauri-shell/src-tauri/target/release/fasti-b1-tauri-shell"
        },
        "path": {
          "type": "string",
          "pattern": "^benchmarks/b1/tauri-shell/evidence/artifacts/sha256-[0-9a-f]{64}-fasti-b1-tauri-shell$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/sample" }
    },
    "summary": { "$ref": "#/$defs/aggregateSummary" },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "low_ram_target_bytes",
        "low_ram_target_status",
        "limit_bytes",
        "measured_bytes",
        "status",
        "disposition",
        "effect"
      ],
      "properties": {
        "budget": { "const": "absolute_ceiling" },
        "low_ram_target_bytes": { "const": 100663296 },
        "low_ram_target_status": { "enum": ["pass", "fail"] },
        "limit_bytes": { "const": 201326592 },
        "measured_bytes": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pass", "fail"] },
        "disposition": {
          "enum": [
            "within_low_ram_target",
            "target_miss_requires_b8_tuning",
            "absolute_breach_blocks_b8"
          ]
        },
        "effect": {
          "const": "failure_blocks_b8_packaging_not_b1_contracts"
        }
      }
    }
  },
  "$defs": {
    "aggregateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_ms",
        "steady_cgroup_memory_bytes",
        "peak_cgroup_memory_bytes",
        "process_count_peak"
      ],
      "properties": {
        "startup_ms": { "$ref": "#/$defs/summary" },
        "steady_cgroup_memory_bytes": { "$ref": "#/$defs/summary" },
        "peak_cgroup_memory_bytes": { "$ref": "#/$defs/summary" },
        "process_count_peak": { "$ref": "#/$defs/summary" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "median", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "systemd_unit",
        "ready_file",
        "argv",
        "command",
        "startup_ms",
        "steady_cgroup_memory_bytes",
        "peak_cgroup_memory_bytes",
        "process_count_peak"
      ],
      "properties": {
        "run": { "type": "integer", "minimum": 1 },
        "systemd_unit": {
          "type": "string",
          "pattern": "^fasti-b1-tauri-[0-9a-f]{32}\\.scope$"
        },
        "ready_file": {
          "type": "string",
          "pattern": "^/(?:[^/]+/)*fasti-tauri-b1-[^/]+/ready$"
        },
        "argv": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1 }
        },
        "command": { "type": "string", "minLength": 1 },
        "startup_ms": { "type": "number", "minimum": 0 },
        "steady_cgroup_memory_bytes": { "type": "integer", "minimum": 1 },
        "peak_cgroup_memory_bytes": { "type": "integer", "minimum": 1 },
        "process_count_peak": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
