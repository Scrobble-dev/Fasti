{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json",
  "title": "Fasti B1 performance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "body",
    "status",
    "captured_at",
    "runner",
    "source",
    "budget_snapshot",
    "harness",
    "scenarios",
    "artifact_sizes",
    "budget_verdicts"
  ],
  "properties": {
    "$schema": {
      "const": "https://fasti.scrobble.dev/schemas/benchmarks/b1/evidence.schema.json"
    },
    "schema_version": { "const": "fasti.b1.performance-evidence.v2" },
    "body": { "const": "B1" },
    "status": { "enum": ["complete", "test_fixture"] },
    "captured_at": { "type": "string", "minLength": 20 },
    "runner": { "$ref": "#/$defs/runner" },
    "source": { "$ref": "#/$defs/source" },
    "budget_snapshot": { "$ref": "#/$defs/budgetSnapshot" },
    "harness": { "$ref": "#/$defs/harness" },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "artifact_sizes": { "$ref": "#/$defs/artifactSizes" },
    "budget_verdicts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/verdict" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "runner": {
            "type": "object",
            "properties": {
              "hardware_profile": { "not": { "const": "unclassified" } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "runner": {
            "type": "object",
            "properties": {
              "hardware_profile": { "const": "unclassified" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_id",
        "hardware_profile",
        "hardware_profile_derivation",
        "physicality",
        "custodian",
        "os_release",
        "kernel_release",
        "architecture",
        "cpu_model",
        "device_model",
        "logical_cpu_count",
        "total_memory_bytes",
        "cgroup_version",
        "container_engine"
      ],
      "properties": {
        "runner_id": { "$ref": "#/$defs/nonEmptyString" },
        "hardware_profile": {
          "enum": [
            "raspberry_pi_5_champion",
            "j4125_calibrated",
            "ugoos_am6b_plus",
            "xiaomi_box_m3",
            "nvidia_shield",
            "representative_tv",
            "unclassified"
          ]
        },
        "hardware_profile_derivation": { "const": "fingerprint_rule_v1" },
        "physicality": { "$ref": "#/$defs/physicality" },
        "custodian": { "$ref": "#/$defs/nonEmptyString" },
        "os_release": { "$ref": "#/$defs/nonEmptyString" },
        "kernel_release": { "$ref": "#/$defs/nonEmptyString" },
        "architecture": { "$ref": "#/$defs/nonEmptyString" },
        "cpu_model": { "$ref": "#/$defs/nonEmptyString" },
        "device_model": {
          "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }]
        },
        "logical_cpu_count": { "type": "integer", "minimum": 1 },
        "total_memory_bytes": { "type": "integer", "minimum": 1 },
        "cgroup_version": { "const": "v2" },
        "container_engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "context",
            "endpoint",
            "socket_path",
            "locality"
          ],
          "properties": {
            "name": { "const": "docker" },
            "version": { "$ref": "#/$defs/nonEmptyString" },
            "context": { "$ref": "#/$defs/nonEmptyString" },
            "endpoint": { "type": "string", "pattern": "^unix:///" },
            "socket_path": { "type": "string", "pattern": "^/" },
            "locality": { "const": "verified_local_unix_socket" }
          }
        }
      }
    },
    "physicality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mechanism",
        "systemd_detect_virt",
        "cpu_hypervisor_flag",
        "dmi"
      ],
      "properties": {
        "status": { "enum": ["physical", "test_fixture"] },
        "mechanism": {
          "enum": [
            "raspberry_pi_device_tree",
            "j4125_systemd_cpu_dmi_cross_check",
            "device_tree_model",
            "test_fixture"
          ]
        },
        "systemd_detect_virt": {
          "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }]
        },
        "cpu_hypervisor_flag": { "type": "boolean" },
        "dmi": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/nonEmptyString" },
              "required": ["sys_vendor", "product_name"],
              "properties": {
                "sys_vendor": { "$ref": "#/$defs/nonEmptyString" },
                "product_name": { "$ref": "#/$defs/nonEmptyString" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "git_tree",
        "tree_state",
        "native_fastid_sha256",
        "native_artifact_origin",
        "oci_image_ref",
        "oci_image_id",
        "oci_source_labels",
        "contract_ref"
      ],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree_state": { "const": "clean" },
        "native_fastid_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_artifact_origin": {
          "const": "extracted_from_immutable_oci_image"
        },
        "oci_image_ref": { "$ref": "#/$defs/nonEmptyString" },
        "oci_image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "oci_source_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "org.opencontainers.image.revision",
            "dev.scrobble.fasti.source.tree",
            "dev.scrobble.fasti.contracts"
          ],
          "properties": {
            "org.opencontainers.image.revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dev.scrobble.fasti.source.tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dev.scrobble.fasti.contracts": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "contract_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "budgetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256", "memory_bytes"],
      "properties": {
        "source": { "const": "benchmarks/b1/budgets.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "memory_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idle_target",
            "normal_target",
            "heavy_target",
            "absolute_ceiling"
          ],
          "properties": {
            "idle_target": { "type": "integer", "minimum": 1 },
            "normal_target": { "type": "integer", "minimum": 1 },
            "heavy_target": { "type": "integer", "minimum": 1 },
            "absolute_ceiling": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "repetitions",
        "steady_window_seconds",
        "sample_interval_ms",
        "baseline_subtraction",
        "fingerprint_commands",
        "native_artifact_commands",
        "artifact_size_commands",
        "source_recheck_commands"
      ],
      "properties": {
        "version": { "const": "fasti-b1-benchmark.v2" },
        "repetitions": { "type": "integer", "minimum": 3 },
        "steady_window_seconds": { "type": "number", "minimum": 3 },
        "sample_interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "baseline_subtraction": { "const": false },
        "fingerprint_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "native_artifact_commands": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "artifact_size_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "source_recheck_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "networkDenied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "observed", "mechanism", "proof"],
      "properties": {
        "required": { "const": true },
        "observed": { "const": true },
        "mechanism": {
          "enum": [
            "linux_network_namespace_without_routes",
            "docker_network_none"
          ]
        },
        "proof": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "workloadExit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation", "observed_code", "matched"],
      "properties": {
        "expectation": {
          "enum": ["running_until_harness_stop", "guarded_nonzero"]
        },
        "observed_code": { "type": ["integer", "null"] },
        "matched": { "const": true }
      }
    },
    "positiveSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "median", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "startup_ms",
        "steady_process_tree_rss_bytes",
        "steady_process_tree_rss_statistics",
        "peak_process_tree_rss_bytes",
        "process_tree_cpu_seconds",
        "process_tree_cpu_percent",
        "process_count_peak",
        "cgroup",
        "container_identity"
      ],
      "properties": {
        "run": { "type": "integer", "minimum": 1 },
        "startup_ms": { "type": "number", "minimum": 0 },
        "steady_process_tree_rss_bytes": { "type": "integer", "minimum": 1 },
        "steady_process_tree_rss_statistics": {
          "$ref": "#/$defs/positiveSummary"
        },
        "peak_process_tree_rss_bytes": { "type": "integer", "minimum": 1 },
        "process_tree_cpu_seconds": { "type": "number", "minimum": 0 },
        "process_tree_cpu_percent": { "type": "number", "minimum": 0 },
        "process_count_peak": { "type": "integer", "minimum": 1 },
        "cgroup": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "steady_memory_current_bytes",
                "steady_memory_current_statistics",
                "peak_memory_bytes",
                "cpu_seconds",
                "cpu_percent"
              ],
              "properties": {
                "steady_memory_current_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "steady_memory_current_statistics": {
                  "$ref": "#/$defs/positiveSummary"
                },
                "peak_memory_bytes": { "type": "integer", "minimum": 1 },
                "cpu_seconds": { "type": "number", "minimum": 0 },
                "cpu_percent": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "container_identity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["container_id", "host_pid", "cgroup_path"],
              "properties": {
                "container_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "host_pid": { "type": "integer", "minimum": 1 },
                "cgroup_path": {
                  "type": "string",
                  "pattern": "^/sys/fs/cgroup/"
                }
              }
            }
          ]
        }
      }
    },
    "scenarioSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_ms",
        "steady_process_tree_rss_bytes",
        "peak_process_tree_rss_bytes",
        "process_tree_cpu_seconds",
        "process_tree_cpu_percent",
        "process_count_peak",
        "steady_cgroup_memory_current_bytes",
        "peak_cgroup_memory_bytes",
        "cgroup_cpu_seconds",
        "cgroup_cpu_percent"
      ],
      "properties": {
        "startup_ms": { "$ref": "#/$defs/positiveSummary" },
        "steady_process_tree_rss_bytes": { "$ref": "#/$defs/positiveSummary" },
        "peak_process_tree_rss_bytes": { "$ref": "#/$defs/positiveSummary" },
        "process_tree_cpu_seconds": { "$ref": "#/$defs/positiveSummary" },
        "process_tree_cpu_percent": { "$ref": "#/$defs/positiveSummary" },
        "process_count_peak": { "$ref": "#/$defs/positiveSummary" },
        "steady_cgroup_memory_current_bytes": {
          "oneOf": [{ "$ref": "#/$defs/positiveSummary" }, { "type": "null" }]
        },
        "peak_cgroup_memory_bytes": {
          "oneOf": [{ "$ref": "#/$defs/positiveSummary" }, { "type": "null" }]
        },
        "cgroup_cpu_seconds": {
          "oneOf": [{ "$ref": "#/$defs/positiveSummary" }, { "type": "null" }]
        },
        "cgroup_cpu_percent": {
          "oneOf": [{ "$ref": "#/$defs/positiveSummary" }, { "type": "null" }]
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "measurement_scope",
        "status",
        "network_denied",
        "commands",
        "workload_exit",
        "samples",
        "summary"
      ],
      "properties": {
        "id": {
          "enum": [
            "native_empty_process",
            "native_fastid_idle",
            "oci_empty_process",
            "oci_fastid_idle",
            "oci_fasti_cli_guard"
          ]
        },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "measurement_scope": {
          "enum": ["native_process_tree", "oci_process_tree_and_cgroup_v2"]
        },
        "status": { "const": "measured" },
        "network_denied": { "$ref": "#/$defs/networkDenied" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "workload_exit": { "$ref": "#/$defs/workloadExit" },
        "samples": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/sample" }
        },
        "summary": { "$ref": "#/$defs/scenarioSummary" }
      }
    },
    "artifactSizes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_fastid_binary_bytes",
        "oci_fastid_binary_bytes",
        "oci_fasti_cli_binary_bytes",
        "oci_image_bytes"
      ],
      "properties": {
        "native_fastid_binary_bytes": { "type": "integer", "minimum": 1 },
        "oci_fastid_binary_bytes": { "type": "integer", "minimum": 1 },
        "oci_fasti_cli_binary_bytes": { "type": "integer", "minimum": 1 },
        "oci_image_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "limit_bytes",
        "measured_bytes",
        "status",
        "reason"
      ],
      "properties": {
        "budget": {
          "enum": [
            "idle_target",
            "normal_target",
            "heavy_target",
            "absolute_ceiling"
          ]
        },
        "limit_bytes": { "type": "integer", "minimum": 1 },
        "measured_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["pass", "fail", "not_applicable"] },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
